# Pinned versions for the integration Camunda stack (docker-compose.yaml).
# Overrides the compose default so CI is reproducible instead of tracking the
# moving 8.10-SNAPSHOT tag. docker compose auto-loads this file.
#
# Pinned to the SDK's target minor (8.10). This is the latest concrete 8.10
# release on Docker Hub and the version the SDK was validated against.
CAMUNDA_VERSION=8.10.0-alpha3
