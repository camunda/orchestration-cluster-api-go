# Pinned versions for the integration Camunda stack (docker-compose.yaml).
# Overrides the compose default so CI is reproducible instead of tracking the
# moving 8.10-SNAPSHOT tag. docker compose auto-loads this file.
#
# Pinned to the same release the sibling SDKs run in CI (proven to reach a
# healthy /actuator/health/status with the H2/RDBMS simple stack). The Go SDK
# targets 8.10 but tolerates server version skew (see hook_05); bump this to an
# 8.10 release once one boots healthy in CI.
CAMUNDA_VERSION=8.9.0-alpha4
