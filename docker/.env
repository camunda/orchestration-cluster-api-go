# Pinned versions for the integration Camunda stack (docker-compose.yaml).
# docker compose auto-loads this file.
#
# Tracking 8.10-SNAPSHOT: the newest concrete release, 8.10.0-alpha3, fails to
# install partition services on startup ("Services not installed",
# Partition-default-1 UNHEALTHY), so the broker never becomes healthy and the
# integration job times out. 8.10-SNAPSHOT (rebuilt from camunda main, which
# the SDK's spec also tracks) picks up the fix. Re-pin to the next concrete
# 8.10 alpha once it is published and confirmed to boot.
CAMUNDA_VERSION=8.10-SNAPSHOT
