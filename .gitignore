# Build output / local artifacts
/dist/

# Generated documentation artifacts (see `make docs-md`)
/docs-json/
/docs-md/
*.out
*.test
*.exe
coverage.txt

# Transient upstream clone created by the schema bundler / proto fetch
external-spec/upstream/
external-spec/upstream/**/.tmp*

# Side-effect report written by check-example-coverage.py on every run
external-spec/missing-examples.json

# Node (used only for codegen tooling: openapi-generator-cli, buf, bundler)
node_modules/

# Python bytecode cache from the post-processing hooks
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Planning artifacts (not part of the SDK)
Seizing the Polyglot Moment*
