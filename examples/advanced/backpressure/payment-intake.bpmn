<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="payment-intake-definitions"
                  targetNamespace="https://camunda.com/examples/go-sdk">
  <bpmn:message id="payment-received-message" name="payment-received" />
  <bpmn:process id="go-example-payment-intake" name="Payment intake" isExecutable="true">
    <bpmn:startEvent id="payment-received" name="Payment received">
      <bpmn:outgoing>to-payment-recorded</bpmn:outgoing>
      <bpmn:messageEventDefinition id="payment-received-definition" messageRef="payment-received-message" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to-payment-recorded" sourceRef="payment-received" targetRef="payment-recorded" />
    <bpmn:endEvent id="payment-recorded" name="Payment recorded">
      <bpmn:incoming>to-payment-recorded</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="payment-intake-diagram">
    <bpmndi:BPMNPlane id="payment-intake-plane" bpmnElement="go-example-payment-intake">
      <bpmndi:BPMNShape id="payment-received-shape" bpmnElement="payment-received">
        <dc:Bounds x="180" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="154" y="145" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payment-recorded-shape" bpmnElement="payment-recorded">
        <dc:Bounds x="330" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="304" y="145" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to-payment-recorded-edge" bpmnElement="to-payment-recorded">
        <di:waypoint x="216" y="120" />
        <di:waypoint x="330" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
